# ---- Atom (NTT DATA) payment gateway ----------------------------------------
# ATOM_ENV=uat uses the test gateway (no real money). For live: ATOM_ENV=prod plus the
# production keys from NDPS (production URLs are built in).
ATOM_ENV=uat
ATOM_MERCH_ID=
ATOM_PASSWORD=
ATOM_PRODUCT_ID=NSE
ATOM_REQ_ENC_KEY=
ATOM_REQ_SALT=
ATOM_RES_ENC_KEY=
ATOM_RES_SALT=
ATOM_REQ_HASH_KEY=
ATOM_RES_HASH_KEY=
# API Secret Key (msk_…) — sent as Bearer on the otsv2 endpoints
ATOM_API_SECRET_KEY=
# Defaults follow ATOM_ENV (uat/prod) per the NDPS docs; override only if NDPS gives different URLs
# ATOM_AUTH_URL=
# ATOM_CDN_URL=
# ATOM_STATUS_URL=
# Public address of the ERP; Atom sends the payer back here (e.g. https://theprideandjoy.com)
# APP_URL=
# Used when a student has no email on record
# ATOM_DEFAULT_EMAIL=
